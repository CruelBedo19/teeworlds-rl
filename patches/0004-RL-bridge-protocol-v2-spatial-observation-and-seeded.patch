+// idle, flying, grabbed, retracting
+static void HookOneHot(int State, float *pOut)
+{
+	if(State == HOOK_IDLE)
+		pOut[0] = 1.0f;
+	else if(State == HOOK_FLYING)
+		pOut[1] = 1.0f;
+	else if(State == HOOK_GRABBED)
