+}
+
+// the region a client receives entities for, see CEntity::NetworkClipped
+static bool InView(vec2 Delta)
+{
+	return absolute(Delta.x) <= 1000.0f && absolute(Delta.y) <= 800.0f && length(Delta) <= 1100.0f;
