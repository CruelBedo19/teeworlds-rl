+unsigned CRlEnv::NextRandom()
+{
+	// xorshift32, separate from rand() so the game's own random stream is untouched
+	m_RngState ^= m_RngState<<13;
+	m_RngState ^= m_RngState>>17;
+	m_RngState ^= m_RngState<<5;
+	return m_RngState;
