@@ -160,6 +160,15 @@ public:
 
 	int64 m_Lastheartbeat;
 
+	// rl simulation mode, all copied from the config once in Run()
+	int m_RlMode;
+	int m_RlBenchTicks;
+	int m_RlHashInterval;
+	int m_RlCatchups;
+	int64 m_RlBenchStartTime;
+	int64 m_RlBenchStartCpu;
+	int64 m_RlLastNetPump;
+
 	// map
 	enum
 	{
@@ -253,6 +262,9 @@ public:
 
 	void PumpNetwork();
 
+	void RlBenchTick();
+	void RlStateHash();
+
 	const char *GetMapName();
 	int LoadMap(const char *pMapName);
 
diff --git a/src/engine/shared/config_variables.h b/src/engine/shared/config_variables.h
index 7a5211e..a5ef156 100644
--- a/src/engine/shared/config_variables.h
+++ b/src/engine/shared/config_variables.h
@@ -95,6 +95,11 @@ MACRO_CONFIG_INT(SvRconBantime, sv_rcon_bantime, 5, 0, 1440, CFGFLAG_SAVE|CFGFLA
 MACRO_CONFIG_INT(SvAutoDemoRecord, sv_auto_demo_record, 0, 0, 1, CFGFLAG_SAVE|CFGFLAG_SERVER, "Automatically record demos")
 MACRO_CONFIG_INT(SvAutoDemoMax, sv_auto_demo_max, 10, 0, 1000, CFGFLAG_SAVE|CFGFLAG_SERVER, "Maximum number of automatically recorded demos (0 = no limit)")
 
+MACRO_CONFIG_INT(SvRlMode, sv_rl_mode, 0, 0, 2, CFGFLAG_SERVER, "Simulation speed mode, read once at startup (0 = realtime, 1 = fast ticks, 2 = fast ticks with minimal snapshot/network work). Modes 1 and 2 do not support human clients")
+MACRO_CONFIG_INT(SvRlSeed, sv_rl_seed, 0, 0, 2147483647, CFGFLAG_SERVER, "Seed rand() with this value at startup (0 = keep the time based seed)")
+MACRO_CONFIG_INT(SvRlBenchTicks, sv_rl_bench_ticks, 0, 0, 2147483647, CFGFLAG_SERVER, "Measure the tick rate over this many ticks after a 500 tick warmup, print it and shut down (0 = off)")
+MACRO_CONFIG_INT(SvRlHashInterval, sv_rl_hash_interval, 0, 0, 2147483647, CFGFLAG_SERVER, "Print a hash of the game state snapshot every this many ticks (0 = off)")
+
 MACRO_CONFIG_STR(EcBindaddr, ec_bindaddr, 128, "localhost", CFGFLAG_SAVE|CFGFLAG_ECON, "Address to bind the external console to. Anything but 'localhost' is dangerous")
 MACRO_CONFIG_INT(EcPort, ec_port, 0, 0, 0, CFGFLAG_SAVE|CFGFLAG_ECON, "Port to use for the external console")
 MACRO_CONFIG_STR(EcPassword, ec_password, 32, "", CFGFLAG_SAVE|CFGFLAG_ECON, "External console password")
