+#ifndef GAME_SERVER_RLENV_H
+#define GAME_SERVER_RLENV_H
+
+#include <generated/protocol.h>
+
+// Lockstep bridge to an external RL trainer over a unix socket. Only created when
+// sv_rl_socket is set. Two server side players are driven by the actions received from
+// the trainer and observations and events are sent back every sv_rl_action_ticks ticks.
+// The wire format is documented in teeworlds-rl/twrl/protocol.py and must match it.
+class CRlEnv
+{
+public:
+	enum
+	{
+		NUM_AGENTS=2,
+		OBS_DIM=23,
+
+		PROTOCOL_MAGIC=0x4C525754, // "TWRL"
+		PROTOCOL_VERSION=1,
+
+		MSG_HELLO=1,
+		MSG_RESET,
+		MSG_STEP,
+		MSG_CLOSE,
+		MSG_OBS,
+		MSG_ERROR,
+		MSG_DEBUG_KILL,
+
+		ERROR_PROTOCOL=1,
+		ERROR_STATE,
+		ERROR_DEBUG_DISABLED,
+
+		FLAG_GAME_NOT_RUNNING=1,
+	};
+
+	struct CHeader
+	{
+		unsigned m_Magic;
+		unsigned short m_Version;
+		unsigned short m_Type;
+		unsigned m_Seq;
+		unsigned m_Size;
+	};
+
+	struct CHello
+	{
+		unsigned m_NumAgents;
+		unsigned m_ObsDim;
+		unsigned m_ActionSize;
+		unsigned m_ActionTicks;
+		unsigned m_TickSpeed;
+		unsigned m_EpisodeTicks;
+		char m_aMap[32];
+	};
+
+	struct CReset
+	{
+		unsigned m_Seed;
+		unsigned m_Reserved;
+	};
+
+	struct CAction
+	{
+		int m_Direction;
+		int m_Jump;
+		int m_Fire;
+		int m_Hook;
+		int m_TargetX;
+		int m_TargetY;
+	};
+
+	struct CAgentObs
+	{
+		int m_Kills;
+		int m_Deaths;
+		int m_Suicides;
+		int m_DamageDealt;
+		int m_DamageTaken;
+		int m_Score;
+		float m_aObs[OBS_DIM];
+	};
+
+	struct CObs
+	{
+		unsigned m_EpisodeID;
+		unsigned m_EpisodeTick;
+		unsigned m_ServerTick;
+		unsigned char m_Terminated;
+		unsigned char m_Truncated;
+		unsigned short m_Flags;
+		unsigned m_Reserved;
+		CAgentObs m_aAgents[NUM_AGENTS];
+	};
+
+	struct CError
+	{
+		unsigned m_Code;
+		char m_aMsg[64];
+	};
+
+	CRlEnv(class CGameContext *pGameServer);
+	~CRlEnv();
+
+	// connects, sends HELLO and adds the agents, false if the bridge could not be set up
+	bool Init();
+	// call at the start of every tick, before the world ticks; may block for the trainer
+	void PreTick();
+
+	void OnDamage(int Victim, int From, int Amount);
+	void OnDeath(int Victim, int Killer, int Weapon);
+
+private:
+	enum
+	{
+		STATE_WAIT_COMMAND=0,
+		STATE_RESETTING,
+		STATE_RUNNING,
+		STATE_DONE,
+		STATE_CLOSED,
+	};
+
+	class CGameContext *m_pGameServer;
+	class CGameContext *GameServer() const { return m_pGameServer; }
+
+	int m_Socket;
+	int m_State;
+	unsigned m_PendingSeq;
+	unsigned m_EpisodeID;
+	int m_EpisodeTick;
+	int m_StepTicksLeft;
+	int m_ActionTicks;
+	int m_EpisodeTicks;
+
+	int m_aClientID[NUM_AGENTS];
+	CAction m_aAction[NUM_AGENTS];
+	int m_aFireCounter[NUM_AGENTS];
+	int m_aFireHeld[NUM_AGENTS];
+	CAgentObs m_aEvents[NUM_AGENTS];
+
+	int AgentIndex(int ClientID) const;
+	bool BothAlive();
+	void ApplyInputs(bool Neutral);
+	void SetActions(const CAction *pActions);
+	void ClearEvents();
+	void BuildObs(CObs *pObs);
+	void SendObs(int Truncated);
+	void HandleCommand();
+	void StartEpisode(unsigned Seed);
+
+	bool SendMsg(int Type, unsigned Seq, const void *pData, unsigned Size);
+	bool RecvAll(void *pData, unsigned Size);
+	void Fail(int Code, const char *pReason);
+	void Close(const char *pReason);
+};
+
+#endif
