+
+#include "entities/character.h"
+#include "gamecontext.h"
+#include "gamecontroller.h"
+#include "player.h"
+#include "rlenv.h"
+
+// the wire format is the in-memory layout, so make sure no padding sneaks in
+typedef char CHeaderSizeCheck[sizeof(CRlEnv::CHeader) == 16 ? 1 : -1];
+typedef char CHelloSizeCheck[sizeof(CRlEnv::CHello) == 56 ? 1 : -1];
+typedef char CResetSizeCheck[sizeof(CRlEnv::CReset) == 8 ? 1 : -1];
+typedef char CActionSizeCheck[sizeof(CRlEnv::CAction) == 24 ? 1 : -1];
+typedef char CAgentObsSizeCheck[sizeof(CRlEnv::CAgentObs) == 24+4*CRlEnv::OBS_DIM ? 1 : -1];
+typedef char CObsSizeCheck[sizeof(CRlEnv::CObs) == 20+CRlEnv::NUM_AGENTS*sizeof(CRlEnv::CAgentObs) ? 1 : -1];
+typedef char CErrorSizeCheck[sizeof(CRlEnv::CError) == 68 ? 1 : -1];
+
+#if defined(MSG_NOSIGNAL)
+static const int s_SendFlags = MSG_NOSIGNAL;
+#else
+static const int s_SendFlags = 0;
+#endif
+
+CRlEnv::CRlEnv(CGameContext *pGameServer)
+{
+	m_pGameServer = pGameServer;
+	m_Socket = -1;
+	m_State = STATE_WAIT_COMMAND;
+	m_PendingSeq = 0;
+	m_EpisodeID = 0;
+	m_EpisodeTick = 0;
+	m_StepTicksLeft = 0;
+	m_ActionTicks = 1;
+	m_EpisodeTicks = 1;
+	for(int i = 0; i < NUM_AGENTS; i++)
+	{
+		m_aClientID[i] = MAX_CLIENTS-1-i;
+		m_aFireCounter[i] = 0;
+		m_aFireHeld[i] = 0;
+	}
+	mem_zero(m_aAction, sizeof(m_aAction));
+	ClearEvents();
+}
+
+CRlEnv::~CRlEnv()
+{
+#if defined(CONF_FAMILY_UNIX)
+	if(m_Socket >= 0)
+		close(m_Socket);
+#endif
+}
+
+bool CRlEnv::Init()
+{
+	CConfig *pConfig = GameServer()->Config();
+	m_ActionTicks = pConfig->m_SvRlActionTicks;
+	m_EpisodeTicks = pConfig->m_SvRlEpisodeTicks;
+
+#if !defined(CONF_FAMILY_UNIX) || !defined(CONF_ARCH_ENDIAN_LITTLE)
+	dbg_msg("rl", "the rl bridge needs unix sockets and a little endian machine");
+	return false;
+#else
+	if(pConfig->m_SvMaxClients > MAX_CLIENTS-NUM_AGENTS)
+	{
+		// a connecting client could otherwise get an agent's slot
+		dbg_msg("rl", "sv_max_clients must be at most %d with the rl bridge", MAX_CLIENTS-NUM_AGENTS);
+		return false;
+	}
+
+	struct sockaddr_un Addr;
+	mem_zero(&Addr, sizeof(Addr));
+	Addr.sun_family = AF_UNIX;
+	if(str_length(pConfig->m_SvRlSocket) >= (int)sizeof(Addr.sun_path))
+	{
+		dbg_msg("rl", "socket path too long: '%s'", pConfig->m_SvRlSocket);
+		return false;
+	}
+	str_copy(Addr.sun_path, pConfig->m_SvRlSocket, sizeof(Addr.sun_path));
+
+	m_Socket = socket(AF_UNIX, SOCK_STREAM, 0);
+	if(m_Socket < 0)
+	{
+		dbg_msg("rl", "socket() failed: %d", errno);
+		return false;
+	}
+#if defined(SO_NOSIGPIPE)
+	int One = 1;
+	setsockopt(m_Socket, SOL_SOCKET, SO_NOSIGPIPE, &One, sizeof(One));
+#endif
+	if(connect(m_Socket, (struct sockaddr *)&Addr, sizeof(Addr)) != 0)
+	{
+		dbg_msg("rl", "could not connect to '%s': %d", pConfig->m_SvRlSocket, errno);
+		return false;
+	}
+
+	for(int i = 0; i < NUM_AGENTS; i++)
+	{
+		int ClientID = m_aClientID[i];
+		if(GameServer()->m_apPlayers[ClientID])
+		{
+			dbg_msg("rl", "player slot %d is already taken", ClientID);
+			return false;
+		}
+		GameServer()->OnClientConnected(ClientID, true, false);
+		CPlayer *pPlayer = GameServer()->m_apPlayers[ClientID];
+		if(pPlayer->GetTeam() == TEAM_SPECTATORS)
+		{
+			dbg_msg("rl", "agent %d could not join the game, check sv_player_slots", i);
+			return false;
+		}
+		GameServer()->m_pController->OnPlayerConnect(pPlayer);
+	}
+
+	CHello Hello;
+	mem_zero(&Hello, sizeof(Hello));
+	Hello.m_NumAgents = NUM_AGENTS;
+	Hello.m_ObsDim = OBS_DIM;
+	Hello.m_ActionSize = sizeof(CAction);
+	Hello.m_ActionTicks = m_ActionTicks;
+	Hello.m_TickSpeed = GameServer()->Server()->TickSpeed();
+	Hello.m_EpisodeTicks = m_EpisodeTicks;
+	str_copy(Hello.m_aMap, pConfig->m_SvMap, sizeof(Hello.m_aMap));
+	if(!SendMsg(MSG_HELLO, 0, &Hello, sizeof(Hello)))
+		return false;
+
+	dbg_msg("rl", "bridge connected to '%s', action_ticks=%d episode_ticks=%d", pConfig->m_SvRlSocket, m_ActionTicks, m_EpisodeTicks);
+	return true;
+#endif
+}
+
+void CRlEnv::PreTick()
+{
+	if(m_State == STATE_CLOSED)
+		return;
+
+	if(m_State == STATE_RESETTING)
+	{
+		// keep ticking with neutral input until both agents have spawned
+		if(!BothAlive())
+		{
+			ApplyInputs(true);
+			return;
+		}
+		m_State = STATE_RUNNING;
+		m_EpisodeTick = 0;
+		m_StepTicksLeft = 0;
+		ClearEvents();
+		SendObs(0);
+		HandleCommand();
+	}
+	else if(m_State == STATE_RUNNING && m_StepTicksLeft == 0)
+	{
+		int Truncated = m_EpisodeTick >= m_EpisodeTicks;
+		if(Truncated)
+			m_State = STATE_DONE;
+		SendObs(Truncated);
+		HandleCommand();
+	}
+	else if(m_State == STATE_WAIT_COMMAND || m_State == STATE_DONE)
+		HandleCommand();
+
+	if(m_State == STATE_RUNNING)
+	{
+		ApplyInputs(false);
+		m_StepTicksLeft--;
+		m_EpisodeTick++;
+	}
+	else if(m_State == STATE_RESETTING)
+		ApplyInputs(true);
+}
+
+void CRlEnv::HandleCommand()
+{
+	// read commands until one of them lets the world tick again
+	while(m_State != STATE_CLOSED)
+	{
+		CHeader Header;
+		if(!RecvAll(&Header, sizeof(Header)))
+			return;
+		if(Header.m_Magic != PROTOCOL_MAGIC || Header.m_Version != PROTOCOL_VERSION)
+		{
+			Fail(ERROR_PROTOCOL, "bad magic or version");
+			return;
+		}
+		if(Header.m_Seq != m_PendingSeq+1)
+		{
+			Fail(ERROR_PROTOCOL, "unexpected sequence number");
+			return;
+		}
+		m_PendingSeq = Header.m_Seq;
+
+		switch(Header.m_Type)
+		{
+		case MSG_RESET:
+			{
+				CReset Reset;
+				if(Header.m_Size != sizeof(Reset))
+				{
+					Fail(ERROR_PROTOCOL, "bad reset size");
+					return;
+				}
+				if(!RecvAll(&Reset, sizeof(Reset)))
+					return;
+				StartEpisode(Reset.m_Seed);
+				return;
+			}
+		case MSG_STEP:
+			{
+				CAction aActions[NUM_AGENTS];
+				if(Header.m_Size != sizeof(aActions))
+				{
+					Fail(ERROR_PROTOCOL, "bad step size");
+					return;
+				}
+				if(!RecvAll(aActions, sizeof(aActions)))
+					return;
+				if(m_State != STATE_RUNNING)
+				{
+					Fail(ERROR_STATE, "step without a running episode");
+					return;
+				}
+				SetActions(aActions);
+				m_StepTicksLeft = m_ActionTicks;
+				return;
+			}
+		case MSG_CLOSE:
+			if(Header.m_Size != 0)
+			{
+				Fail(ERROR_PROTOCOL, "bad close size");
+				return;
+			}
+			Close("trainer sent close");
+			return;
+		case MSG_DEBUG_KILL:
+			{
+				unsigned Agent;
+				if(Header.m_Size != sizeof(Agent))
+				{
+					Fail(ERROR_PROTOCOL, "bad debug kill size");
+					return;
+				}
+				if(!RecvAll(&Agent, sizeof(Agent)))
+					return;
+				if(!GameServer()->Config()->m_SvRlDebug)
+				{
+					Fail(ERROR_DEBUG_DISABLED, "debug kill needs sv_rl_debug 1");
+					return;
+				}
+				if(m_State != STATE_RUNNING || Agent >= NUM_AGENTS)
+				{
+					Fail(ERROR_STATE, "debug kill without a running episode or bad agent");
+					return;
+				}
+				// same as a human using the kill command, answered without ticking
+				GameServer()->m_apPlayers[m_aClientID[Agent]]->KillCharacter(WEAPON_SELF);
+				SendObs(0);
+				break;
+			}
+		default:
+			Fail(ERROR_PROTOCOL, "unknown message type");
+			return;
+		}
+	}
+}
+
+void CRlEnv::StartEpisode(unsigned Seed)
+{
+	if(!GameServer()->m_pController->IsGameRunning())
+	{
+		// the restart below only works from a running game, check sv_scorelimit and sv_timelimit
+		Fail(ERROR_STATE, "reset while the game is not running");
+		return;
+	}
+	if(Seed)
+		srand(Seed);
+
+	// same as the restart command: StartMatch, which resets world, scores and respawn
+	// timers on the next world tick, see IGameController::OnReset
+	GameServer()->m_pController->DoWarmup(0);
+
+	m_EpisodeID++;
+	m_State = STATE_RESETTING;
+	m_EpisodeTick = 0;
+	m_StepTicksLeft = 0;
+	for(int i = 0; i < NUM_AGENTS; i++)
+	{
+		m_aFireCounter[i] = 0;
+		m_aFireHeld[i] = 0;
+	}
+	mem_zero(m_aAction, sizeof(m_aAction));
+	ClearEvents();
+}
+
+int CRlEnv::AgentIndex(int ClientID) const
+{
+	for(int i = 0; i < NUM_AGENTS; i++)
+		if(m_aClientID[i] == ClientID)
+			return i;
+	return -1;
+}
+
+bool CRlEnv::BothAlive()
+{
+	for(int i = 0; i < NUM_AGENTS; i++)
+	{
+		CPlayer *pPlayer = GameServer()->m_apPlayers[m_aClientID[i]];
+		if(!pPlayer || !pPlayer->GetCharacter())
+			return false;
+	}
+	return true;
+}
+
+void CRlEnv::SetActions(const CAction *pActions)
+{
+	for(int i = 0; i < NUM_AGENTS; i++)
+	{
+		m_aAction[i] = pActions[i];
+
+		// like the client, count every press and every release
+		int Held = pActions[i].m_Fire ? 1 : 0;
+		if(Held != m_aFireHeld[i])
+		{
+			m_aFireCounter[i] = (m_aFireCounter[i]+1)&INPUT_STATE_MASK;
+			m_aFireHeld[i] = Held;
+		}
+	}
+}
+
+void CRlEnv::ApplyInputs(bool Neutral)
+{
+	for(int i = 0; i < NUM_AGENTS; i++)
+	{
+		CPlayer *pPlayer = GameServer()->m_apPlayers[m_aClientID[i]];
+		if(!pPlayer)
+			continue;
+
+		CNetObj_PlayerInput Input;
+		mem_zero(&Input, sizeof(Input));
+		Input.m_PlayerFlags = PLAYERFLAG_BOT;
+		Input.m_Fire = m_aFireCounter[i];
+		if(!Neutral)
+		{
+			Input.m_Direction = clamp(m_aAction[i].m_Direction, -1, 1);
+			Input.m_Jump = m_aAction[i].m_Jump ? 1 : 0;
+			Input.m_Hook = m_aAction[i].m_Hook ? 1 : 0;
+			Input.m_TargetX = m_aAction[i].m_TargetX;
+			Input.m_TargetY = m_aAction[i].m_TargetY;
+		}
+
+		// same order as a network client: direct input on arrival, predicted input at the tick
+		pPlayer->OnDirectInput(&Input);
+		pPlayer->OnPredictedInput(&Input);
+	}
+}
+
+void CRlEnv::OnDamage(int Victim, int From, int Amount)
+{
+	int VictimIndex = AgentIndex(Victim);
+	if(VictimIndex < 0 || Amount <= 0)
+		return;
+	m_aEvents[VictimIndex].m_DamageTaken += Amount;
+	if(From != Victim)
+	{
+		int FromIndex = AgentIndex(From);
+		if(FromIndex >= 0)
+			m_aEvents[FromIndex].m_DamageDealt += Amount;
+	}
+}
+
+void CRlEnv::OnDeath(int Victim, int Killer, int Weapon)
+{
+	// WEAPON_GAME deaths come from resets and team changes and are not scored either
+	int VictimIndex = AgentIndex(Victim);
+	if(VictimIndex < 0 || Weapon == WEAPON_GAME)
+		return;
+	if(Killer < 0 || Killer == Victim)
+	{
+		m_aEvents[VictimIndex].m_Suicides++;
+		return;
+	}
+	m_aEvents[VictimIndex].m_Deaths++;
+	int KillerIndex = AgentIndex(Killer);
+	if(KillerIndex >= 0)
+		m_aEvents[KillerIndex].m_Kills++;
+}
+
+void CRlEnv::ClearEvents()
+{
+	mem_zero(m_aEvents, sizeof(m_aEvents));
+}
+
+void CRlEnv::BuildObs(CObs *pObs)
+{
+	mem_zero(pObs, sizeof(*pObs));
+	pObs->m_EpisodeID = m_EpisodeID;
+	pObs->m_EpisodeTick = m_EpisodeTick;
+	pObs->m_ServerTick = GameServer()->Server()->Tick();
+	if(!GameServer()->m_pController->IsGameRunning())
+		pObs->m_Flags |= FLAG_GAME_NOT_RUNNING;
+
+	for(int i = 0; i < NUM_AGENTS; i++)
+	{
+		CAgentObs *pAgent = &pObs->m_aAgents[i];
+		*pAgent = m_aEvents[i];
+		CPlayer *pPlayer = GameServer()->m_apPlayers[m_aClientID[i]];
+		CPlayer *pOppPlayer = GameServer()->m_apPlayers[m_aClientID[NUM_AGENTS-1-i]];
+		pAgent->m_Score = pPlayer->m_Score;
+
+		// dead characters read as all zeros apart from the alive flag
+		CCharacter *pSelf = pPlayer->GetCharacter();
+		CCharacter *pOpp = pOppPlayer->GetCharacter();
+		float *pOut = pAgent->m_aObs;
+
+		if(pSelf)
+		{
+			pOut[0] = 1.0f;
+			pOut[1] = pSelf->m_Core.m_Pos.x;
+			pOut[2] = pSelf->m_Core.m_Pos.y;
+			pOut[3] = pSelf->m_Core.m_Vel.x;
+			pOut[4] = pSelf->m_Core.m_Vel.y;
+			pOut[5] = pSelf->m_Health;
+			pOut[6] = pSelf->m_Armor;
+			pOut[7] = pSelf->m_ActiveWeapon;
+			pOut[8] = pSelf->m_aWeapons[pSelf->m_ActiveWeapon].m_Ammo;
+			pOut[9] = pSelf->m_ReloadTimer;
+			pOut[10] = pSelf->IsGrounded() ? 1.0f : 0.0f;
+			pOut[11] = pSelf->m_Core.m_Jumped;
+			pOut[12] = pSelf->m_Core.m_HookState;
+			pOut[13] = pSelf->m_Core.m_HookPos.x - pSelf->m_Core.m_Pos.x;
+			pOut[14] = pSelf->m_Core.m_HookPos.y - pSelf->m_Core.m_Pos.y;
+		}
+		if(pOpp)
+		{
+			pOut[15] = 1.0f;
+			if(pSelf)
+			{
+				pOut[16] = pOpp->m_Core.m_Pos.x - pSelf->m_Core.m_Pos.x;
+				pOut[17] = pOpp->m_Core.m_Pos.y - pSelf->m_Core.m_Pos.y;
+			}
+			pOut[18] = pOpp->m_Core.m_Vel.x;
+			pOut[19] = pOpp->m_Core.m_Vel.y;
+			pOut[20] = pOpp->m_ActiveWeapon;
+			pOut[21] = pOpp->m_Core.m_HookState;
+		}
+		pOut[22] = m_EpisodeTick / (float)m_EpisodeTicks;
+	}
+}
+
+void CRlEnv::SendObs(int Truncated)
+{
+	CObs Obs;
+	BuildObs(&Obs);
+	Obs.m_Truncated = Truncated;
+	ClearEvents();
+	SendMsg(MSG_OBS, m_PendingSeq, &Obs, sizeof(Obs));
+}
+
+bool CRlEnv::SendMsg(int Type, unsigned Seq, const void *pData, unsigned Size)
+{
+#if defined(CONF_FAMILY_UNIX)
+	char aBuf[sizeof(CHeader)+sizeof(CObs)];
+	if(m_Socket < 0 || Size > sizeof(aBuf)-sizeof(CHeader))
+		return false;
+
+	CHeader Header;
+	Header.m_Magic = PROTOCOL_MAGIC;
+	Header.m_Version = PROTOCOL_VERSION;
+	Header.m_Type = Type;
+	Header.m_Seq = Seq;
+	Header.m_Size = Size;
+	mem_copy(aBuf, &Header, sizeof(Header));
+	mem_copy(aBuf+sizeof(Header), pData, Size);
+
+	unsigned Total = sizeof(Header)+Size;
+	unsigned Sent = 0;
+	while(Sent < Total)
+	{
+		int Ret = send(m_Socket, aBuf+Sent, Total-Sent, s_SendFlags);
+		if(Ret < 0 && errno == EINTR)
+			continue;
+		if(Ret <= 0)
+		{
+			Close("send failed, trainer gone");
+			return false;
+		}
+		Sent += Ret;
+	}
+	return true;
+#else
+	return false;
+#endif
+}
+
+bool CRlEnv::RecvAll(void *pData, unsigned Size)
+{
+#if defined(CONF_FAMILY_UNIX)
+	int Timeout = GameServer()->Config()->m_SvRlTimeout;
+	unsigned Received = 0;
+	while(Received < Size)
+	{
+		struct pollfd Poll;
+		Poll.fd = m_Socket;
+		Poll.events = POLLIN;
+		Poll.revents = 0;
+		int Ret = poll(&Poll, 1, Timeout > 0 ? Timeout : -1);
+		if(Ret < 0 && errno == EINTR)
+			continue;
+		if(Ret == 0)
+		{
+			Close("timed out waiting for the trainer");
+			return false;
+		}
+		if(Ret < 0)
+		{
+			Close("poll failed");
+			return false;
+		}
+
+		Ret = recv(m_Socket, (char *)pData+Received, Size-Received, 0);
+		if(Ret < 0 && errno == EINTR)
+			continue;
+		if(Ret <= 0)
+		{
+			Close("trainer disconnected");
+			return false;
+		}
+		Received += Ret;
+	}
+	return true;
+#else
+	return false;
+#endif
+}
+
+void CRlEnv::Fail(int Code, const char *pReason)
+{
+	CError Error;
+	mem_zero(&Error, sizeof(Error));
+	Error.m_Code = Code;
+	str_copy(Error.m_aMsg, pReason, sizeof(Error.m_aMsg));
+	SendMsg(MSG_ERROR, m_PendingSeq, &Error, sizeof(Error));
+	Close(pReason);
+}
+
+void CRlEnv::Close(const char *pReason)
+{
+	if(m_State == STATE_CLOSED)
+		return;
+	dbg_msg("rl", "bridge closed: %s", pReason);
+#if defined(CONF_FAMILY_UNIX)
+	if(m_Socket >= 0)
+		close(m_Socket);
+#endif
+	m_Socket = -1;
+	m_State = STATE_CLOSED;
+	// the server exists for the trainer only, so stop it
+	GameServer()->Console()->ExecuteLine("shutdown");
+}
